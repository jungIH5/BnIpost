# ============================
# BnIpost 환경 변수 설정 예시
# .env.example을 복사해서 .env로 만들고 실제 값을 입력하세요
# cp .env.example .env
# ============================

# --- 데이터베이스 ---
DB_NAME=bnipost
DB_USER=bnipost
DB_PASSWORD=your_strong_password_here

# --- JWT 시크릿 (32자 이상 임의 문자열) ---
JWT_SECRET=change-this-to-a-very-long-random-secret-key-32chars

# --- 내부 API 키 (Java ↔ Python 서버 간 통신) ---
INTERNAL_API_KEY=your-internal-api-key

# --- Naver API (https://developers.naver.com 에서 앱 등록) ---
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:8080/auth/naver/callback

# --- Meta / Instagram API (https://developers.facebook.com 에서 앱 등록) ---
# 인스타그램 비즈니스/크리에이터 계정 필수
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8080/auth/instagram/callback

# --- Anthropic Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- Frontend URL (Java 서버가 OAuth 완료 후 리다이렉트할 주소) ---
FRONTEND_URL=http://localhost:3000

# --- Next.js 공개 환경 변수 (브라우저에서 사용) ---
NEXT_PUBLIC_JAVA_URL=http://localhost:8080
NEXT_PUBLIC_PYTHON_URL=http://localhost:8000
